# Copier ce fichier en .env.local et remplir les valeurs. Ne jamais committer .env.local.
# Les variables préfixées VITE_, NEXT_PUBLIC_ ou EXPO_PUBLIC_ sont publiques (visibles dans le navigateur).

# Exemple de variable publique
VITE_SITE_URL=http://localhost:5173

